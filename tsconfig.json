{
  // src/*.js 는 build.py 가 한 파일로 이어 붙이는 "전역 스크립트"라서
  // TypeScript 도 import/export 없는 스크립트로 보고 전역 스코프를 공유해서 검사한다.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.js", "src/**/*.ts"]
}
